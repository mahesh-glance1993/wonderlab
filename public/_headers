# Security + caching headers for static assets (Workers static assets `_headers`).
# /api/* is handled by the Worker (run_worker_first) and sets its own headers in worker/index.ts.
# CSP notes:
#  - fonts are self-hosted under /fonts (no third-party font requests, so visitors' IPs never reach a font CDN);
#    data: is still allowed in font-src.
#  - img-src data:/blob: — colouring pages are data: SVGs, art exports/previews use blob:/data: URLs.
#  - media-src 'self' — narration audio from /api/tts and /audio/*; blob:/data: for generated clips.
#  - React `style={{…}}` props are applied through the CSSOM, which style-src does not restrict,
#    so no 'unsafe-inline' is needed. No inline <script> exists in the production index.html.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), browsing-topics=(), fullscreen=(self), clipboard-write=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed build output never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Realistic pictures (copied from the apps at build time; names are stable, so revalidate daily).
/pictures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Must always be revalidated so new deploys reach every device.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/packs.json
  Cache-Control: no-cache
/shell.json
  Cache-Control: no-cache

# Android APK for direct download (/get-app, scripts/publish-apk.mjs): always revalidate, never treated as a page.
/download/*
  Cache-Control: no-cache
/download/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="wonderlab.apk"

# Self-hosted fonts (stable names; revalidate weekly).
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
