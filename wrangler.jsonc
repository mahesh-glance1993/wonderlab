{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wonderlab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wonderlab", "database_id": "local-wonderlab", "migrations_dir": "migrations" }
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "SESSION_IDLE_DAYS": "30",
    "SESSION_MAX_DAYS": "60",
    "SHARED_IDLE_MIN": "60"
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "wonderlab",
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://learn.maheshglance.com",
        "SESSION_IDLE_DAYS": "30",
        "SESSION_MAX_DAYS": "60",
        "SHARED_IDLE_MIN": "60",
        "EMAIL_FROM": "WonderLab <no-reply@maheshglance.com>"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "wonderlab", "database_id": "9aad147e-678e-45e6-987e-945b2e1bc1c4", "migrations_dir": "migrations" }
      ],
      "ai": { "binding": "AI" },
      "routes": [{ "pattern": "learn.maheshglance.com", "custom_domain": true }]
    }
  }
}
