{
  "name": "wonderlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply wonderlab --local",
    "db:seed": "vite-node scripts/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json && vite build",
    "start": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler d1 migrations apply wonderlab --env production --remote && wrangler deploy --env production",
    "docs:coverage": "vite-node scripts/gen-coverage.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm test && vite build"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "playwright-core": "^1.49.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  }
}
